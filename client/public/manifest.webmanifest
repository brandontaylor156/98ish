{
  "name": "98ish",
  "short_name": "98ish",
  "description": "A Windows 98-style desktop in your browser",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#008080",
  "theme_color": "#008080",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "text/*", "audio/*", "application/json", "application/rtf", ".jpg", ".jpeg", ".png", ".gif", ".webp", ".heic", ".txt", ".md", ".csv", ".json", ".html", ".htm", ".rtf", ".wav", ".mp3", ".m4a"]
        }
      ]
    }
  },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
